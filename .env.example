# Supabase (app + ingest)
# Dashboard > Project Settings > API Keys. Usar las claves nuevas
# (publishable/secret), no las "Legacy API Keys" (anon/service_role JWT).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo para el worker de ingesta (nunca en el cliente/app). Ignora RLS.
SUPABASE_SECRET_KEY=

# Ticketmaster Discovery API
TICKETMASTER_API_KEY=
