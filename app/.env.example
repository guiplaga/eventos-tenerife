# Mismos valores que SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY del .env raiz.
# Prefijo EXPO_PUBLIC_ obligatorio: Expo solo expone al cliente las variables
# que empiezan asi. Nunca poner aqui la secret key -- esto se compila dentro
# de la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
